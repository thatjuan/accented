<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Accented Info.plist.

  CFBundleShortVersionString / CFBundleVersion are the single version source of truth
  (Scripts/release.sh bumps them). Sparkle keys: SUPublicEDKey is a placeholder (32 zero
  bytes) until generate_keys is run for Accented — do NOT reuse diarc's key or overwrite
  the shared Sparkle keychain item. See docs/decisions/0002-sparkle-auto-updates.md.

  Note on TCC usage-string keys: Accessibility does NOT use a per-app Info.plist usage-description
  key (there is no NSAccessibilityUsageDescription the system reads). The OS shows a generic TCC
  prompt, so no usage string is declared here.

  This app is non-sandboxed (diarc ARCHITECTURE §7): no App Sandbox entitlement, no sandbox key
  here. Sandbox forbids the cross-app AX and CGEvent posting the picker depends on.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Accented</string>
	<key>CFBundleExecutable</key>
	<string>Accented</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>com.thatjuan.accented</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Accented</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Juan Jaramillo. All rights reserved.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://accented.app/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</string>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
</dict>
</plist>
